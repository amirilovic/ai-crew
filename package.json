{
  "name": "ai-crew",
  "version": "0.1.0",
  "description": "Multi-agent development team automation with Claude Agent SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ai-crew.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/ai-crew/issues"
  },
  "homepage": "https://github.com/your-username/ai-crew#readme",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc && npm run copy-agents",
    "copy-agents": "cp -r src/agents dist/",
    "dev": "tsx watch src/index.ts",
    "start": "pm2 start ecosystem.config.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "node-cron": "^3.0.0",
    "winston": "^3.14.0",
    "zod": "^3.23.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
